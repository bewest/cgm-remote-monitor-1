modules = ["nodejs-20"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
PORT = "5000"
HOSTNAME = "0.0.0.0"
MONGO_CONNECTION = "mongodb://localhost:27017/nightscout"
API_SECRET = "nightscout_secure_password"
INSECURE_USE_HTTP = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Nightscout Server"

[[workflows.workflow]]
name = "Nightscout Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "lib/server/server.js"]
build = ["npm", "run", "bundle"]
